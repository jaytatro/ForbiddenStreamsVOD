<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ForbiddenStreams" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/toxic_green</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ForbiddenStreams.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <!-- Player buttons and settings menus turn green when selected -->
        <item name="android:selectableItemBackground">@drawable/player_focus_background</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/player_focus_background</item>
        <item name="android:colorControlHighlight">#806CCD4E</item>
        <item name="android:colorControlActivated">#FF90E15D</item>
        <item name="android:colorAccent">#FF90E15D</item>
    </style>
</resources>
