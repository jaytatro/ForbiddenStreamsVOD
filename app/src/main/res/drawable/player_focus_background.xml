<?xml version="1.0" encoding="utf-8"?>
<!-- Player controls: green when selected with the remote, matching the rest of the app. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#B36CCD4E" />
            <stroke android:width="2dp" android:color="#FF90E15D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF6CCD4E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#806CCD4E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
